# =============================================================================
# Secrets & credentials
# =============================================================================
.env
*.pem
*.key

# =============================================================================
# Backups and Pre-restore backups
# =============================================================================
backups/
*.bak

# =============================================================================
# MySQL data volume
# =============================================================================
db/

# =============================================================================
# Ghost content — ignore everything except the custom themes
# =============================================================================
content/apps/
content/data/
content/files/
content/images/
content/logs/
content/media/
content/public/
content/settings/
content/themes/casper
content/themes/casper/
content/themes/source
content/themes/source/

# Keep the custom theme
!content/themes/kalp-dev/

poetry-content/apps/
poetry-content/data/
poetry-content/files/
poetry-content/images/
poetry-content/logs/
poetry-content/media/
poetry-content/public/
poetry-content/settings/
poetry-content/themes/casper
poetry-content/themes/casper/
poetry-content/themes/source
poetry-content/themes/source/

# Keep the poetry theme
!poetry-content/themes/poetry-theme/

blog-content/apps/
blog-content/data/
blog-content/files/
blog-content/images/
blog-content/logs/
blog-content/media/
blog-content/public/
blog-content/settings/
blog-content/themes/casper
blog-content/themes/casper/
blog-content/themes/source
blog-content/themes/source/

# Keep the blog theme
!blog-content/themes/blog-theme/


# =============================================================================
# One-off SQL migration scripts (already applied)
# =============================================================================
*.sql

# =============================================================================
# OS / editor / Python noise
# =============================================================================
__pycache__/
*.pyc
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
