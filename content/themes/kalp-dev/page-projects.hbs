{{!< default}}

{{#post}}
<article class="post-full page-template page-projects">
    <div class="container">

        <header class="post-full__header projects-header">
            <h1 class="post-full__title">{{title}}</h1>
        </header>

        <div class="projects-grid">

            <!-- 1. Second Brain -->
            <div class="project-card">
                <div class="project-card__tags">
                    <span class="project-tag">AI Knowledge Base</span>
                    <span class="project-tag">Hybrid RAG</span>
                    <span class="project-tag">Qdrant Vector DB</span>
                    <span class="project-tag">FastAPI</span>
                    <span class="project-tag">Ollama</span>
                    <span class="project-tag">Docker</span>
                </div>
                <h2 class="project-card__title">Second Brain: AI Knowledge &amp; Retrieval Platform</h2>
                <p class="project-card__desc">
                    Private, offline AI knowledge base and search platform engineered to index technical notes and code. Combines semantic vector search (Qdrant) with exact keyword matching (BM25) and two-stage cross-encoder reranking to eliminate search blind spots. Features a full-stack dashboard with real-time SSE token streaming, interactive relationship graphs, and automated evaluation metrics tracking context relevance and groundedness—running 100% locally with Ollama and embedded Qdrant.
                </p>
                <div class="project-card__links">
                    <a href="https://brain.kalp.dev" class="project-link project-link--live" target="_blank" rel="noopener noreferrer">
                        <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                        <span>Live Demo ↗</span>
                    </a>
                    <a href="https://github.com/Kalp-S/second-brain" class="project-link" target="_blank" rel="noopener noreferrer">
                        <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
