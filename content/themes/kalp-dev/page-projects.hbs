            <!-- 8. tictactoe-AI -->
            <div class="project-card">
                <div class="project-card__tags">
                    <span class="project-tag">React</span>
                    <span class="project-tag">JavaScript</span>
                    <span class="project-tag">Minimax Algorithm</span>
                    <span class="project-tag">Game AI</span>
                </div>
                <h2 class="project-card__title">Unbeatable Tic-Tac-Toe AI</h2>
                <p class="project-card__desc">
                    An interactive browser game featuring an unbeatable AI opponent powered by the Minimax algorithm with depth-penalized scoring. Includes adjustable difficulty modes, clean React state management, and persistent score tracking.
