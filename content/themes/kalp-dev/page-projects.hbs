{{!< default}}

{{#post}}
<article class="post-full page-template page-projects">
    <div class="container">

        <header class="post-full__header projects-header">
            <h1 class="post-full__title">{{title}}</h1>
            <p class="projects-subtitle">Selected systems architecture, self-hosted infrastructure, and developer tooling.</p>
        </header>

        <div class="projects-grid">

            <div class="project-card">
                <div class="project-card__tags">
                    <span class="project-tag">Docker Compose</span>
                    <span class="project-tag">Cloudflare Tunnels</span>
                    <span class="project-tag">Ghost</span>
                    <span class="project-tag">MySQL</span>
                    <span class="project-tag">Python</span>
                </div>
                <h2 class="project-card__title">Personal Cloud Platform &amp; Infrastructure</h2>
                <p class="project-card__desc">
                    Self-hosted production infrastructure running on local hardware exposed via Cloudflare zero-trust tunnels. Features automated multi-database backup pipelines to offsite storage, automated restore scripts, and end-to-end Python integration testing.
                </p>
                <div class="project-card__links">
                    <a href="https://github.com/Kalp-S/personal-website" class="project-link" target="_blank" rel="noopener noreferrer">
                        <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
                        <span>Source Code</span>
                    </a>
                    <a href="https://kalp.dev" class="project-link project-link--live" target="_blank" rel="noopener noreferrer">
                        <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                        <span>Live Site</span>
                    </a>
                </div>
            </div>

            <div class="project-card">
                <div class="project-card__tags">
                    <span class="project-tag">Python</span>
                    <span class="project-tag">Selenium WebDriver</span>
                    <span class="project-tag">Raspberry Pi</span>
                    <span class="project-tag">Linux</span>
                </div>
                <h2 class="project-card__title">Facility Reservation Automation Engine</h2>
                <p class="project-card__desc">
                    High-reliability booking daemon running 24/7 on a Raspberry Pi to execute precise, scheduled reservations for high-demand municipal athletic facilities. Features headless browser scheduling, session state persistence, and automatic retry handling.
                </p>
                <div class="project-card__links">
                    <a href="https://github.com/Kalp-S/mississaugaBooking" class="project-link" target="_blank" rel="noopener noreferrer">
                        <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
                        <span>Source Code</span>
                    </a>
                </div>
            </div>

            <div class="project-card">
                <div class="project-card__tags">
                    <span class="project-tag">Docker</span>
                    <span class="project-tag">PostgreSQL</span>
                    <span class="project-tag">Cloudflare Tunnels</span>
                    <span class="project-tag">systemd</span>
                </div>
                <h2 class="project-card__title">Self-Hosted Joplin Sync Server</h2>
                <p class="project-card__desc">
                    Secure self-hosted synchronization server for Joplin notes, backed by PostgreSQL and containerized with Docker Compose. Integrated with automated database snapshots, Google Drive replication, and zero-trust Cloudflare ingress routing.
                </p>
                <div class="project-card__links">
                    <a href="https://github.com/Kalp-S/joplin-server" class="project-link" target="_blank" rel="noopener noreferrer">
                        <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
                        <span>Source Code</span>
                    </a>
                </div>
            </div>

            <div class="project-card">
                <div class="project-card__tags">
                    <span class="project-tag">Kubernetes</span>
                    <span class="project-tag">TimescaleDB</span>
                    <span class="project-tag">Helm</span>
                    <span class="project-tag">PostgreSQL</span>
                </div>
                <h2 class="project-card__title">TimescaleDB on Kubernetes</h2>
                <p class="project-card__desc">
                    Configuration and deployment recipes using Helm charts to deploy TimescaleDB time-series database clusters on Kubernetes (AWS EKS, MicroK8s, Minikube) for high-scale IoT and metric data storage.
                </p>
                <div class="project-card__links">
                    <a href="https://github.com/Kalp-S/timescaledb-kubernetes" class="project-link" target="_blank" rel="noopener noreferrer">
                        <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
                        <span>Source Code</span>
                    </a>
                </div>
            </div>

        </div>

    </div>
</article>
{{/post}}
