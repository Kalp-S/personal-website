                        <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
                        <span>Source Code</span>
                    </a>
                </div>
            </div>

            <!-- 3. FireSafetyCapstone -->
            <div class="project-card">
                <div class="project-card__tags">
                    <span class="project-tag">IoT &amp; LoRaWAN</span>
                    <span class="project-tag">Reinforcement Learning</span>
                    <span class="project-tag">Node-RED</span>
                    <span class="project-tag">Python</span>
                    <span class="project-tag">Android</span>
                    <span class="project-tag">Embedded C++</span>
                </div>
                <h2 class="project-card__title">Smart Fire Evacuation &amp; IoT Sensor Network</h2>
                <p class="project-card__desc">
                    An emergency evacuation system that monitors indoor environmental hazards in real time. Microcontroller sensor nodes transmit temperature and gas levels over LoRaWAN to an MQTT gateway, where a reinforcement learning pathfinding model dynamically calculates hazard-free exit routes and streams directions to an Android app.
                </p>
                <div class="project-card__links">
                    <a href="https://github.com/Kalp-S/FireSafetyCapstone" class="project-link" target="_blank" rel="noopener noreferrer">
                        <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
                        <span>Source Code</span>
                    </a>
                </div>
            </div>

            <!-- 4. OnlineCafeSystem -->
            <div class="project-card">
                <div class="project-card__tags">
                    <span class="project-tag">React</span>
                    <span class="project-tag">Node.js</span>
                    <span class="project-tag">Express</span>
                    <span class="project-tag">AWS DynamoDB</span>
                    <span class="project-tag">Role-Based Access</span>
                    <span class="project-tag">REST APIs</span>
