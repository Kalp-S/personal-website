{{!< default}}

<article class="post-full page-template page-about landing-about">
    <div class="content-container">

        <header class="post-full__header">
            <h1 class="hero__title">Kalp Shah</h1>
            <p class="hero__subtitle">Software Engineer &amp; Builder</p>
        </header>

        {{#get "pages" filter="slug:about" limit="1" as |about|}}
            {{#foreach about}}
                <section class="post-content">
                    {{content}}
                </section>
            {{/foreach}}
        {{else}}
            <section class="post-content">
                <p>Hey, I am Kalp. 👋</p>

                <p>I am a <strong>Software Engineer</strong> in Calgary specializing in backend systems, distributed infrastructure, and clean energy platforms. Currently at <strong>Energy Toolbase</strong>, engineering software to model and deploy solar and energy storage systems at scale.</p>

                <p>Explore my <a href="/projects/">projects</a>, view my <a href="/resume/">resume</a>, or connect on <a href="https://github.com/Kalp-S/" target="_blank" rel="noopener noreferrer">GitHub</a> and <a href="https://www.linkedin.com/in/kalp-shah-72b99019a/" target="_blank" rel="noopener noreferrer">LinkedIn</a>.</p>
            </section>
        {{/get}}

    </div>
</article>
